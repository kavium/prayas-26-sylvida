# Official local checkout containing run.py and tsr/.
TRIPOSR_REPOSITORY_PATH=/absolute/path/to/TripoSR
# Python from TripoSR's dedicated environment, not the Prayas API environment.
TRIPOSR_PYTHON_EXECUTABLE=/absolute/path/to/triposr-env/bin/python
TRIPOSR_MODEL=stabilityai/TripoSR
TRIPOSR_DEVICE=cuda:0
TRIPOSR_CHUNK_SIZE=8192
TRIPOSR_MC_RESOLUTION=256
TRIPOSR_FOREGROUND_RATIO=0.85
TRIPOSR_REMOVE_BACKGROUND=true
TRIPOSR_TIMEOUT_SECONDS=900
